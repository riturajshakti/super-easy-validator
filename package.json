{
	"name": "super-easy-validator",
	"version": "0.9.0",
	"description": "A super simple npm package which helps in validation in much simpler way. Its inspired by laravel validator but its even better, also its more powerful than express-validator",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=16.6"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/riturajshakti/super-easy-validator.git"
	},
	"homepage": "https://github.com/riturajshakti/super-easy-validator#readme",
	"bugs": {
		"url": "https://github.com/riturajshakti/super-easy-validator/issues"
	},
	"scripts": {
		"build": "tsc",
		"watch": "tsc -w",
		"test": "npm run build && node --test test/*.test.js",
		"prepublishOnly": "npm run build && npm test"
	},
	"author": "Rituraj Shakti",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.6.2",
		"nodemon": "^2.0.22",
		"typescript": "^5.2.2"
	},
	"keywords": [
		"validator",
		"validation",
		"schema",
		"data validation",
		"input validation",
		"form validation",
		"validation rules",
		"typescript",
		"zero dependency",
		"laravel validator"
	]
}
