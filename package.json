{
	"name": "super-easy-validator",
	"version": "0.9.0",
	"description": "Validate data with rules you write as plain strings, like 'optional|email'. Zero dependencies, ~18 kB, fully typed. No builder chains or schemas.",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=16.6"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/riturajshakti/super-easy-validator.git"
	},
	"homepage": "https://github.com/riturajshakti/super-easy-validator#readme",
	"bugs": {
		"url": "https://github.com/riturajshakti/super-easy-validator/issues"
	},
	"scripts": {
		"build": "tsc",
		"watch": "tsc -w",
		"test": "npm run build && node --test test/*.test.js",
		"prepublishOnly": "npm run build && npm test"
	},
	"author": "Rituraj Shakti",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.6.2",
		"nodemon": "^2.0.22",
		"typescript": "^5.2.2"
	},
	"keywords": [
		"validator",
		"validation",
		"validate",
		"schema",
		"schema-validation",
		"data-validation",
		"input-validation",
		"form-validation",
		"request-validation",
		"validation-rules",
		"typescript",
		"type-safe",
		"zero-dependency",
		"lightweight",
		"nodejs",
		"express",
		"api-validation",
		"json-validation",
		"object-validation",
		"zod",
		"joi",
		"yup",
		"ajv",
		"valibot",
		"superstruct",
		"express-validator",
		"zod-alternative",
		"joi-alternative",
		"yup-alternative"
	]
}
